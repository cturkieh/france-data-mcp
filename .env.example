# ============================================
# .env.example — france-data-mcp
# Copier vers .env.local et remplir les valeurs nécessaires.
# ============================================

# --- Supabase (FINESS + Annuaire Santé Ameli ingérés) ---
# Obligatoire pour les tools FINESS / Ameli en mode serveur MCP.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- INSEE SIRENE V3 (fallback authentifié pour entreprise_by_siren) ---
# Optionnel. Quand `recherche-entreprises.api.gouv.fr` (DINUM) ne retourne pas
# un SIREN (cas diffusion partielle INSEE — `statut_diffusion ∈ {P,N}`), on
# fallback automatiquement sur l'API SIRENE INSEE V3 si ces clés sont set.
# Sans ces clés, le tool `entreprise_by_siren` retourne `found: false` quand
# DINUM ne connaît pas le SIREN (comportement V0.4.3 historique préservé).
#
# S'inscrire et obtenir client_id/client_secret : https://portail-api.insee.fr
# Auth : OAuth2 client_credentials sur
#   https://auth.insee.net/auth/realms/apim-gravitee/protocol/openid-connect/token
INSEE_SIRENE_CLIENT_ID=
INSEE_SIRENE_CLIENT_SECRET=
