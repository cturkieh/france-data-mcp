# ============================================
# .env.example — france-data-mcp
# Copier vers .env.local et remplir les valeurs nécessaires.
# ============================================

# --- Supabase (FINESS + Ameli + RPPS ingérés) ---
# Obligatoire pour les tools FINESS / Ameli / RPPS en mode serveur MCP.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- INSEE SIRENE V3.11 (fallback authentifié pour entreprise_by_siren) ---
# Optionnel. Quand `recherche-entreprises.api.gouv.fr` (DINUM) ne retourne pas
# un SIREN (cas diffusion partielle INSEE — `statut_diffusion ∈ {P,N}`), on
# fallback automatiquement sur l'API SIRENE INSEE V3.11 si la clé est set.
# Sans clé, le tool `entreprise_by_siren` retourne `found: false` quand DINUM
# ne connaît pas le SIREN (comportement V0.4.3 historique préservé).
#
# S'inscrire et obtenir une clé : https://portail-api.insee.fr
# (souscrire à l'API Sirene 3.11, plan "api key" → UUID)
# Auth : header `X-INSEE-Api-Key-Integration: <UUID>`. Rate limit 30 req/min.
INSEE_SIRENE_API_KEY=

# --- ANS FHIR Annuaire Santé (fallback live pour professionnel_by_rpps) ---
# Optionnel. Quand `professionnel_by_rpps` ne trouve pas un RPPS en base
# locale (snapshot mensuel J-30 max), on fallback automatiquement sur l'API
# FHIR ANS si la clé est set. Sans clé, retourne `found: false`.
#
# Inscription gratuite : https://portal.api.esante.gouv.fr (Gravitee). Souscrire
# au plan "API FHIR Annuaire Santé" → UUID dans la section Souscriptions.
# Auth : header `ESANTE-API-KEY: <UUID>`. Pas de quota documenté pendant la bêta.
ANS_FHIR_API_KEY=
# Override optionnel de l'endpoint (par défaut: gateway.api.esante.gouv.fr/fhir/v2).
# À remplir uniquement pour test contre un mock ou un futur endpoint ANS.
# ANS_FHIR_BASE_URL=

# --- URL CSV RPPS (override optionnel) ---
# Par défaut, l'ingestion utilise l'alias data.gouv stable :
# https://www.data.gouv.fr/api/1/datasets/r/fffda7e9-0ea2-4c35-bba0-4496f3af935d
# (fichier `ps-libreacces-personne-activite.txt`, ~803 Mo, MAJ mensuelle).
# RPPS_CSV_URL=

# --- Rate limit Upstash (endpoint MCP public, V0.5.7) ---
# Optionnel mais FORTEMENT recommandé en production. Sans ces variables, le
# rate limit tombe sur un fallback in-memory qui ne partage pas l'état entre
# invocations Vercel serverless (protège des bursts dans la même instance
# chaude, pas des flood distribués).
#
# Créer une base Upstash Redis gratuite : https://console.upstash.com/redis
# Région recommandée : eu-west-1 (Frankfurt) — colocalisée avec Vercel CDG.
# Copier les valeurs depuis l'onglet "REST API" du dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limite en requêtes / minute / IP appliquée sur `tools/call` (les méthodes
# meta `initialize` / `tools/list` / `ping` restent libres). Default : 60.
# RATE_LIMIT_PER_MINUTE=60

# Mettre à `false` pour désactiver complètement le rate limit (dev local
# uniquement, jamais en prod). Default : enabled.
# RATE_LIMIT_ENABLED=false

# --- Salt pour hash IP (privacy, V0.8.3+) ---
# FORTEMENT recommandé en prod. Sans salt, un attaquant peut rainbow-tabler
# les 4 milliards d'IPv4 en quelques heures et désanonymiser tous les logs.
# La CNIL classe le hash IP non-salé comme pseudonyme (donnée personnelle),
# pas anonyme. Avec un salt secret, le hash devient effectivement anonyme.
#
# Format : string opaque ≥ 32 caractères, idéalement généré via
# `openssl rand -hex 32`. À rotater manuellement chaque mois si tu veux
# casser la corrélation des IP-hashes entre périodes (recommandé > 30j).
#
# Sans salt configuré, l'endpoint marche mais les logs ne sont pas
# RGPD-compliant pour une rétention > 24h.
FRANCE_DATA_IP_SALT=

# --- Axiom (log drain endpoint MCP, V0.8.4+) ---
# Optionnel. Avec ces deux variables set, chaque event MCP est push en plus
# des logs Vercel vers un dataset Axiom (rétention 30 jours, queryable en APL).
# Sans ces variables, Axiom est en no-op (les logs JSON restent dans Vercel
# Runtime Logs, ~1h rétention sur Hobby tier).
#
# Setup :
# 1. Créer compte gratuit https://app.axiom.co/register
# 2. Créer un dataset (retention: 30 days)
# 3. Settings > API Tokens > New Token (Advanced > Custom permissions :
#    Ingest CREATE sur le dataset cible UNIQUEMENT — least privilege)
# 4. Copier le token (Axiom ne le réaffiche jamais)
#
# Auth : header `Authorization: Bearer <token>`. Timeout client 1.5s.
AXIOM_TOKEN=
AXIOM_DATASET=
# Override de l'hôte Axiom (hostname seul, sans protocole). Défaut :
# `api.axiom.co` (région US). Utiliser `api.eu.axiom.co` si le compte Axiom
# est en région EU — cohérence avec la localisation des données promise par
# PRIVACY.md. La région du compte se vérifie dans Axiom > Settings > General.
# AXIOM_HOST=api.eu.axiom.co

# --- Sentry (error monitoring endpoint MCP) ---
# Optionnel. Sans DSN, Sentry est en no-op silencieux (un warn console au
# 1er appel pour rendre la désactivation visible côté ops). Tracing et
# profiling sont volontairement OFF — l'observabilité fine passe par les
# logs JSON structurés (cf. `api/_lib/observability.ts`).
#
# Créer un projet Sentry : https://command-center.sentry.io/projects/new/
# (plateforme "Node.js", framework "Vanilla"). Copier le DSN public.
SENTRY_DSN=
# Override optionnel de l'environnement. Default = VERCEL_ENV (production /
# preview / development) ou "development" en local.
# SENTRY_ENVIRONMENT=production
# Override optionnel de la release. Default = VERCEL_GIT_COMMIT_SHA.
# SENTRY_RELEASE=
